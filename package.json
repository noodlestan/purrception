{
  "name": "purrception",
  "version": "0.0.12",
  "description": "Collection of abstractions and tools for building metadata extraction pipelines from local and remote sources using heuristics, schemas, and factories.",
  "author": "Noodlestan Collective",
  "license": "MIT",
  "private": true,
  "packageManager": "npm@10.2.3",
  "workspaces": [
    "libs/*",
    "cli/*"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "turbo": "turbo",
    "dev": "turbo run dev --ui tui",
    "clean": "turbo run build:clean",
    "lint": "prettier . -c",
    "lint:fix": "prettier . -c --write",
    "extract": "echo no purrception yet",
    "ci:root": "npm run lint",
    "ci": "npm run ci:root && turbo run ci"
  },
  "dependencies": {
    "@purrception/primitives": "file:libs/primitives"
  },
  "devDependencies": {
    "@noodlestan/eslint-config": "^0.0.8",
    "@noodlestan/tsconfig": "^0.0.12",
    "@types/node": "^25.9.3",
    "@typescript-eslint/eslint-plugin": "8.11.0",
    "eslint": "8.57.1",
    "eslint-config-standard": "17.1.0",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-prettier": "5.5.6",
    "lefthook": "2.1.9",
    "prettier": "3.8.4",
    "rollup": "^4.61.1",
    "solid-js": "1.9.13",
    "turbo": "2.9.18",
    "typescript": "5.9.3",
    "vite": "8.0.16",
    "vite-plugin-solid": "2.11.12",
    "vite-plugin-solid-svg": "0.8.1",
    "vite-plugin-top-level-await": "1.6.0",
    "vitest": "^4.1.8"
  }
}
